{
   "swagger":"2.0",
   "info":{
      "description":"Object Storage WS",
      "version":"1.0.0",
      "title":"Object Storage WS"
   },
   "host":"127.0.0.1:8081",
   "basePath":"/",
   "tags":[
      {
         "name":"/pagopa/services/storage",
         "description":"Object Storage Service Impl"
      }
   ],
   "paths":{
      "/pagopa/services/storage/getDownload":{
         "get":{
            "tags":[
               "/pagopa/services/storage"
            ],
            "summary":"GetDownload",
            "description":"Get presigned Url storage for download",
            "operationId":"getDownload",
            "produces":[
               "*/*"
            ],
            "parameters":[
               {
                  "name":"fileObjectId",
                  "in":"query",
                  "required":false,
                  "type":"string"
               },
               {
                  "name":"requestDate",
                  "in":"query",
                  "required":false,
                  "type":"string",
                  "format":"date-time",
                  "x-example":"2023-03-13T18:18:11Z"
               },
               {
                  "name":"requestId",
                  "in":"query",
                  "required":false,
                  "type":"string"
               }
            ],
            "responses":{
               "200":{
                  "description":"OK",
                  "schema":{
                     "$ref":"#/definitions/ObjectStorageResponse"
                  }
               },
               "401":{
                  "description":"Unauthorized"
               },
               "403":{
                  "description":"Forbidden"
               },
               "404":{
                  "description":"Not Found"
               }
            },
            "security":[
               {
                  "Bearer":[
                     
                  ]
               }
            ]
         }
      },
      "/pagopa/services/storage/getUpload":{
         "get":{
            "tags":[
               "/pagopa/services/storage"
            ],
            "summary":"GetUpload",
            "description":"Get presigned Url storage for upload",
            "operationId":"getUpload",
            "produces":[
               "*/*"
            ],
            "parameters":[
               {
                  "name":"fileDate",
                  "in":"query",
                  "required":false,
                  "type":"string",
                  "format":"date-time",
                  "x-example":"2023-03-13T18:18:11Z"
               },
               {
                  "name":"fileName",
                  "in":"query",
                  "required":false,
                  "type":"string"
               },
               {
                  "name":"fileSize",
                  "in":"query",
                  "required":false,
                  "type":"integer",
                  "format":"int64"
               },
               {
                  "name":"fileType",
                  "in":"query",
                  "required":false,
                  "type":"string"
               },
               {
                  "name":"requestDate",
                  "in":"query",
                  "required":false,
                  "type":"string",
                  "format":"date-time",
                  "x-example":"2023-03-13T18:18:11Z"
               },
               {
                  "name":"requestId",
                  "in":"query",
                  "required":false,
                  "type":"string"
               }
            ],
            "responses":{
               "200":{
                  "description":"OK",
                  "schema":{
                     "$ref":"#/definitions/ObjectStorageResponse"
                  }
               },
               "401":{
                  "description":"Unauthorized"
               },
               "403":{
                  "description":"Forbidden"
               },
               "404":{
                  "description":"Not Found"
               }
            },
            "security":[
               {
                  "Bearer":[
                     
                  ]
               }
            ]
         }
      }
   },
   "securityDefinitions":{
      "Bearer":{
         "type":"apiKey",
         "name":"Authorization",
         "in":"header"
      }
   },
   "definitions":{
      "ObjectStorageResponse":{
         "type":"object",
         "properties":{
            "errorCode":{
               "type":"string"
            },
            "errorDescription":{
               "type":"string"
            },
            "fileObjectId":{
               "type":"string"
            },
            "presignedUrl":{
               "type":"string"
            },
            "requestId":{
               "type":"string"
            },
            "responseDate":{
               "type":"string",
               "format":"date-time",
               "example":"2023-03-13T18:18:11Z"
            }
         },
         "title":"ObjectStorageResponse"
      }
   }
}